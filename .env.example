# ============================================================================
# OKR System — modelo de variáveis de ambiente
# Copie para .env (na raiz) e preencha. O .env é gitignored e negado por .htaccess.
# NUNCA commite o .env real.
# ============================================================================

# ----- Ambiente -----
APP_ENV=production            # production | staging | testing
APP_DEBUG=false              # NUNCA true em produção (vaza stack trace/SQL)
TIMEZONE=America/Sao_Paulo

# ----- Banco principal (planni40_okr) -----
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ----- Banco CRM (planni40_crm) — herda do principal se vazio -----
# CRM_DB_HOST=
# CRM_DB_NAME=planni40_crm
# CRM_DB_USER=
# CRM_DB_PASS=

# ----- Banco Landing Pages (planni40_lp) — herda do principal se vazio -----
# Recomendado: usuário MySQL dedicado com escopo só nos schemas de LP (ver Fase 4).
# LP_DB_HOST=
# LP_DB_NAME=planni40_lp
# LP_DB_USER=
# LP_DB_PASS=

# ----- SMTP -----
SMTP_HOST=smtp.titan.email
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
SMTP_FROM=
SMTP_FROM_NAME=OKR System

# ----- WhatsApp Cloud API (opcional) -----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ----- Captcha (login / formulários) -----
CAPTCHA_PROVIDER=off          # recaptcha | hcaptcha | off
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# ============================================================================
# SEGREDOS CRÍTICOS DE SEGURANÇA (Fase 2)
# ============================================================================

# APP_TOKEN_PEPPER — chave HMAC dos tokens da API (app mobile) e dos hashes de
# reset de senha. OBRIGATÓRIO em produção: mínimo 32 caracteres aleatórios.
# Sem um valor forte, a aplicação NÃO inicia em produção (fail-closed).
# Gere um: php -r "echo bin2hex(random_bytes(32));"
# Rotacionar invalida tokens de API (usuários re-logam) e links de reset pendentes.
APP_TOKEN_PEPPER=

# FCM_SERVICE_ACCOUNT_PATH — caminho ABSOLUTO da chave do Firebase, FORA do
# webroot (ex.: /home2/planni40/secrets/firebase-adminsdk.json). Se vazio, o
# código faz fallback para *firebase-adminsdk*.json na raiz do projeto — o que
# é inseguro (arquivo servível via HTTP). Sempre defina esta variável.
FCM_SERVICE_ACCOUNT_PATH=

# HEALTH_CHECK_TOKEN — token dos scripts de operação em tools/ (health, etc.).
HEALTH_CHECK_TOKEN=

# ERROR_LOG_PATH — caminho do log de erros (idealmente fora do webroot).
# ERROR_LOG_PATH=/home2/planni40/logs/okr_error_log
