<Files ".env">
  Require all denied
</Files>

# --- Segurança (Fase 0): bloqueia arquivos sensíveis servidos como texto ---
# Chave de service account do Firebase (fica na raiz; movida p/ fora do webroot na Fase 2)
<FilesMatch "firebase-adminsdk.*\.json$">
  Require all denied
</FilesMatch>
# Dumps SQL, backups (.bak e .bak-AAAAMMDD-HHMMSS), logs e e-mails em fila
<FilesMatch "(\.(sql|eml|log|bak)$|\.bak-[0-9-]+$)">
  Require all denied
</FilesMatch>
<Files "error_log">
  Require all denied
</Files>

# Desabilita listagem de diretórios (uploads/, logs/, tools/, docs/, ...)
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /OKR_system/

  # Redireciona todas as requisições que não forem arquivos ou pastas reais
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Redireciona para index.php com o parâmetro da rota
  RewriteRule ^(.+)$ index.php?path=$1 [QSA,L]

  RewriteEngine On

# detalhe_okr/123 -> views/detalhe_okr.php?id=123
RewriteRule ^detalhe_okr/([0-9]+)/?$ views/detalhe_okr.php?id=$1 [L,QSA]
</IfModule>
